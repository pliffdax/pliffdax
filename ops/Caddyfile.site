# Append to /etc/caddy/Caddyfile; preserve its existing sites and global options.
pliffdax.dev {
	root * /var/www/pliffdax.dev/current
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	header Cache-Control "no-cache"
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path}.html {path} {path}/index.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.pliffdax.dev {
	redir https://pliffdax.dev{uri} permanent
}
